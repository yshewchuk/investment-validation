# Credential template — VARIABLE NAMES ONLY, never values.
#
# The real file lives at /root/investing-plan/.env and is blocked from both
# git remotes by .gitignore AND by checks/repo_hygiene.py, which greps every
# staged blob for the current secret values.
#
# Restore path on a fresh machine: copy this file to .env and fill the values
# from the password manager (never from any repo). See RECOVERY.md.
#
# Usage (source, never echo):
#     set -a; source /root/investing-plan/.env; set +a

# oquants.com session cookie (Playwright token dance — see AGENTS.md).
# COOKIE_NAME is currently __Secure-better-auth.session_token.
export OQUANTS_COOKIE_NAME=
export OQUANTS_COOKIE_VALUE=

# polygon.io API key. Sent as `Authorization: Bearer` via curl (fresh-process
# urllib 401s with a valid key — a known environment quirk).
export POLYGON_API_KEY=

# ORATS api.orats.io key. Sent as the `token=` QUERY PARAM, not a header.
# 20,000 calls/month, resets on the 1st.
export ORATS_API_KEY=

# Phase 3 dashboard publish target. A command template that MUST contain
# {bundle}; without it the nightly falls back to the local directory publisher.
#   e.g. wrangler pages deploy {bundle} --project-name=earnings-board
export DASHBOARD_PUBLISH_CMD=

# Public hostname of that target. The nightly probes it unauthenticated before
# every publish and REFUSES to ship if it answers 200 — positions and licensed
# ORATS-derived quotes never go out without Cloudflare Access in front.
export DASHBOARD_PROBE_URL=
