{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3-flash",
  "permission": {
    "bash": {
      "*": "deny",
      "python3 tools/oc_check.py": "allow",
      "python3 tools/oc_check.py *": "allow",
      "tools/oc_check.py": "allow",
      "tools/oc_check.py *": "allow"
    },
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",
    "skill": "deny",
    "doom_loop": "deny",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "data/*": "deny",
      "fixtures/*": "deny"
    },
    "edit": {
      "*": "allow",
      ".git/*": "deny",
      ".github/*": "deny",
      "*.env": "deny",
      "data/*": "deny",
      "fixtures/*": "deny",
      ".oc_logs/*": "deny",
      "*/.oc_logs/*": "deny",
      "tools/oc_check.py": "deny",
      "tools/opencode_config.json": "deny",
      "*/tools/oc_check.py": "deny",
      "*/tools/opencode_config.json": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "limit": {
            "context": 160000,
            "output": 32000
          }
        },
        "qwen/qwen3.8-flash": {
          "limit": {
            "context": 160000,
            "output": 32000
          }
        },
        "z-ai/glm-5.3-flash": {
          "limit": {
            "context": 160000,
            "output": 32000
          }
        }
      }
    }
  },
  "agent": {
    "title": {
      "disable": true
    },
    "summary": {
      "disable": true
    }
  }
}
