#!/bin/sh
# Versioned pre-commit gate. Installed by `python3 checks/install_hooks.py`.
#
# `.git/hooks` is not versioned, so a fresh clone has none of this and
# `--no-verify` bypasses the one that exists. The hook is a convenience; the
# nightly is the control, and it re-runs checks 1-5 below over HEAD and
# reports whether this file is installed at all (system_rearchitecture.md
# §4.6). A control that cannot detect its own absence is not a control.
# Checks 6 (doc budgets) and 7 (Markdown) are not in the nightly gate; the
# Markdown check is enforced by CI's "Lint Markdown" step.
#
# Inputs in the hook's default mode (checked against each check's code):
#   1 hygiene, 2 import layers, 3 code budgets, 5 v2 lint: STAGED BLOBS of the staged
#     files, so the result is about what would be committed (1 also reads the
#     working-tree .env for secret values; 5 reads requirements.txt staged).
#   4 package READMEs: staged blobs layered over the WORKING-TREE copy of every
#     tracked, unstaged file (the import graph needs the whole tree).
#   6 ARCHITECTURE.md budgets: staged blobs of tracked ARCHITECTURE.md files, compared
#     with the base ref.
#   7 Markdown: the WORKING-TREE copy of each staged .md file (markdownlint-cli2 cannot
#     read a blob). CI lints every .md and is the authority.
# Checks 1-4 and 6 are stdlib-only and parse with `ast` rather than importing, because
# importing `engine.score` loads a panel and a two-minute hook gets deleted. Check 5
# runs the pinned Ruff; check 7 needs Node.
#
# Order is cheapest-and-most-catastrophic first: a leaked credential is
# permanent, a layer violation is not.
set -e

ROOT="$(git rev-parse --show-toplevel)"

# 1. Secrets, data payloads and forbidden paths. Never skip this one.
python3 "$ROOT/checks/repo_hygiene.py" --quiet

# 2. §4.2 import direction, the adapter ledger, and the v2 skeleton.
python3 "$ROOT/checks/import_layers.py" --quiet

# 3. §4.3 code budgets over engine/v2/** only. Legacy is exempt wholesale.
python3 "$ROOT/checks/code_budgets.py" --quiet

# 4. §4.5 package READMEs, with consumers checked against the import graph.
python3 "$ROOT/checks/package_readmes.py" --quiet

# 5. Pinned v2 style/import/dead-code rules, also against staged bytes.
python3 "$ROOT/checks/rearchitecture_phase1_lint.py" --quiet

# 6. ARCHITECTURE.md per-PR growth ceiling: below 1000 lines a PR may add at
#    most 50 net lines; at/over it a doc may only shrink (compression PR or
#    refactor needed first). See checks/architecture_doc_budgets.py.
python3 "$ROOT/checks/architecture_doc_budgets.py" --quiet

# 7. Markdown lint: markdownlint-cli2 (pinned; rules in .markdownlint-cli2.jsonc) on
#    the staged .md files, reading their working-tree copies. CI is the authority.
#    Fails closed when npx is missing.
command -v npx >/dev/null 2>&1 || {
    echo "pre-commit: npx not found; install Node.js (e.g. apt install nodejs npm) to lint Markdown" >&2
    exit 1
}
git -C "$ROOT" diff --cached --name-only -z --diff-filter=ACMR -- '*.md' |
    (cd "$ROOT" && xargs -0 -r npx --yes markdownlint-cli2@0.18.1)

echo "pre-commit: hygiene, layers, budgets, READMEs, v2 lint, doc budgets and markdown lint all green"
